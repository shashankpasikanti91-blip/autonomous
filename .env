# ============================================================================
# Application Environment
# ============================================================================
ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
BASE_URL=http://localhost:8000
API_KEY_REQUIRED=false

# ============================================================================
# PostgreSQL — Primary Database (local development)
# ============================================================================
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/srp_os
# Set to true to print all SQL to console (debug only)
DATABASE_ECHO=false

# ============================================================================
# Firebase & Database Configuration (legacy)
# ============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=your-cert-url
FIRESTORE_PREFIX=platform_
REALTIME_ENABLED=true

# ============================================================================
# Email Service Configuration
# ============================================================================
EMAIL_PROVIDER=smtp
# Options: smtp, gmail, sendgrid

# SMTP Configuration (default - works everywhere)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=noreply@company.com

# Gmail API Configuration (requires OAuth setup)
# EMAIL_PROVIDER=gmail
# GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_OAUTH_CLIENT_SECRET=your-client-secret
# GMAIL_FROM_ADDRESS=noreply@company.com

# SendGrid Configuration (high-volume sending)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.your-sendgrid-key
# SENDGRID_FROM_ADDRESS=noreply@company.com

# ============================================================================
# Messaging Service Configuration
# ============================================================================
# WhatsApp Cloud API (Meta)
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789

# Twilio (SMS alternative)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token

# ============================================================================
# Calendar Service Configuration
# ============================================================================
CALENDAR_PROVIDER=google
# Options: google, outlook

# Google Calendar OAuth
CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
CALENDAR_CLIENT_SECRET=your-client-secret

# ============================================================================
# Payroll Configuration
# ============================================================================
PAYROLL_TAX_RATE=0.15
HEALTH_INSURANCE=200.0
PENSION_RATE=0.05

# ============================================================================
# Invoice Configuration
# ============================================================================
BUSINESS_NAME=Your Company Name
TAX_ID=XX-XXXXXXXX
INVOICE_PREFIX=INV
PAYMENT_TERMS_DAYS=30

# ============================================================================
# CRM Configuration
# ============================================================================
CRM_PROVIDER=hubspot
# Options: hubspot, salesforce

# HubSpot API (private app method)
HUBSPOT_API_KEY=pat-na1-your-private-app-key

# HubSpot OAuth (OAuth app method for user delegation)
HUBSPOT_OAUTH_CLIENT_ID=your-oauth-client-id
HUBSPOT_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# ============================================================================
# N8N Integration Configuration
# ============================================================================
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook
WEBHOOK_SECRET_KEY=your-webhook-secret-key

# ============================================================================
# AI Model Configuration
# ============================================================================
PYDANTIC_AI_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================================================
# Memory Configuration
# ============================================================================
USE_VECTOR_MEMORY=true
USE_FIRESTORE_MEMORY=true
VECTOR_DB_DIMENSION=1536

# ============================================================================
# CORS & Security (Production)
# ============================================================================
ALLOWED_ORIGINS=https://hr.local,https://*.hr.local
SECRET_KEY=change-me-in-production-use-a-long-random-string
TRUST_PROXY_HEADERS=true

# ============================================================================
# Platform Identity
# ============================================================================
PLATFORM_NAME=HR Autonomous OS
PLATFORM_DOMAIN=hr.local

# ============================================================================
# Production API Port (customize per host)
# ============================================================================
API_PORT=8010
API_HOST=127.0.0.1
API_RELOAD=false
ENV=production
DEBUG=false

# ============================================================================
# Application Settings
# ============================================================================
MAX_WORKERS=10
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY_MS=100
USE_VECTOR_MEMORY=True
USE_FIRESTORE_MEMORY=True
VECTOR_DB_DIMENSION=1536
