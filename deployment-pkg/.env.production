# ============================================================================
# HR AUTONOMOUS OS - PRODUCTION ENVIRONMENT
# ============================================================================
# Server: 5.223.67.236
# Domain: autonomous.srpailabs.com + *.autonomous.srpailabs.com
# Database: Isolated PostgreSQL container (port 5544)
# Cloudflare Origin Certificate: /etc/ssl/autonomous.srpailabs.com/

# ============================================================================
# Application Environment
# ============================================================================
ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=127.0.0.1
API_PORT=8010
API_RELOAD=false
BASE_URL=https://autonomous.srpailabs.com
API_KEY_REQUIRED=true

# ============================================================================
# PostgreSQL — Isolated HR Database (production server)
# ============================================================================
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Database: Separate docker container on port 5544 with hr_app user
DATABASE_URL=postgresql://hr_app:hr_secure_password_change_me@localhost:5544/hr_multitenant
DATABASE_ECHO=false

# ============================================================================
# Platform Configuration
# ============================================================================
PLATFORM_NAME=HR Autonomous OS
PLATFORM_DOMAIN=autonomous.srpailabs.com
ALLOWED_ORIGINS=https://autonomous.srpailabs.com,https://*.autonomous.srpailabs.com,https://app.autonomous.srpailabs.com

# ============================================================================
# SSL/TLS Configuration
# ============================================================================
SSL_CERT_PATH=/etc/ssl/autonomous.srpailabs.com/cert.pem
SSL_KEY_PATH=/etc/ssl/autonomous.srpailabs.com/key.pem

# ============================================================================
# Firebase & Database Configuration
# ============================================================================
FIREBASE_PROJECT_ID=hr-autonomous-prod
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=your-cert-url
FIRESTORE_PREFIX=platform_
REALTIME_ENABLED=true

# ============================================================================
# Email Service Configuration
# ============================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@autonomous.srpailabs.com

# ============================================================================
# Security
# ============================================================================
SECRET_KEY=change_me_to_secure_random_key_32_characters_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# CORS & Multi-tenancy
# ============================================================================
TENANT_RESOLUTION_PRIORITY=subdomain,custom_domain,explicit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
