# SRP Autonomous OS - UI Platform Environment

# API Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=30000

# Feature Flags
REACT_APP_ENABLE_ADMIN_CONSOLE=true
REACT_APP_ENABLE_BILLING_DASHBOARD=true
REACT_APP_ENABLE_OBSERVABILITY=true
REACT_APP_ENABLE_API_KEY_MANAGEMENT=true

# UI Configuration
REACT_APP_APP_NAME="SRP Autonomous OS"
REACT_APP_APP_TAGLINE="Enterprise Autonomous AI Platform"
REACT_APP_THEME="dark"

# Metrics
REACT_APP_METRICS_POLL_INTERVAL=30000
REACT_APP_HEALTH_CHECK_INTERVAL=60000

# Analytics (Optional)
REACT_APP_ANALYTICS_ENABLED=false
REACT_APP_SENTRY_DSN=

# Build Configuration
VITE_BUILD_TARGET=ES2020
VITE_SOURCEMAP=true

# Development
VITE_DEV_PORT=3000
VITE_DEV_OPEN=true
