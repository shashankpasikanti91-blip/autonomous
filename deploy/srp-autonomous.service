[Unit]
Description=SRP Autonomous OS — FastAPI backend
Documentation=https://autonomous.srpailabs.com
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/autonomous

# Load environment from .env file
EnvironmentFile=/srv/autonomous/.env

# Start uvicorn with proxy-headers so FastAPI trusts Nginx/Cloudflare forwarded IPs
ExecStart=/srv/autonomous/.venv/bin/python -m uvicorn main:app \
    --host 127.0.0.1 \
    --port 8010 \
    --workers 4 \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1" \
    --log-level info \
    --access-log

# Restart behaviour
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Resource limits
LimitNOFILE=65535
MemoryMax=1G

# Hardening (safe subset — does not break PostgreSQL connections)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/autonomous

[Install]
WantedBy=multi-user.target
